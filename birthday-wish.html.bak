<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Quicksand:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#fdf5ef; --blush:#f7c9cf; --blush-2:#f3b6c2; --lav:#d9c6e8;
    --maroon:#8f2e4a; --maroon-2:#b5486a; --ink:#5a3f4a; --ink-dim:#8a7079;
    --gold:#e9b768;
  }
  *{box-sizing:border-box;}
  html,body{ height:100%; margin:0; overflow:hidden; }
  body{
    background:
      radial-gradient(circle at 8% 12%, rgba(247,201,207,.55), transparent 40%),
      radial-gradient(circle at 92% 85%, rgba(217,198,232,.5), transparent 40%),
      var(--cream);
    color:var(--ink); font-family:'Quicksand', sans-serif;
  }
  .deco{ position:absolute; font-size:20px; opacity:.7; pointer-events:none; user-select:none; }

  .pager{ display:flex; height:100%; width:100%; transition:transform .55s cubic-bezier(.65,0,.35,1); position:relative; z-index:1; }
  .page{ flex:0 0 100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; position:relative; padding:26px 22px 96px; padding-top:calc(26px + env(safe-area-inset-top,0px)); overflow-y:auto; }

  h1{ font-family:'Playfair Display', serif; font-weight:700; font-style:italic; color:var(--maroon);
    font-size:clamp(32px,8vw,50px); margin:6px 0 4px; }
  .eyebrow{ color:var(--ink-dim); font-size:13px; letter-spacing:.03em; margin:0 0 2px; }
  .sub{ color:var(--ink-dim); font-size:14.5px; margin:0 0 26px; max-width:38ch; }
  h2{ font-family:'Playfair Display', serif; font-weight:700; font-style:italic; color:var(--maroon); font-size:clamp(24px,6vw,32px); margin:0 0 8px; }

  .story-btn{ margin-top:26px; padding:12px 28px; background:var(--maroon); color:#fff8f2; border:none;
    border-radius:999px; font-family:'Quicksand'; font-weight:600; font-size:14px; letter-spacing:.02em; cursor:pointer;
    box-shadow:0 8px 18px rgba(143,46,74,.25); transition:transform .15s, box-shadow .15s; }
  .story-btn:hover{ transform:translateY(-2px); box-shadow:0 10px 22px rgba(143,46,74,.32); }
  .story-btn:disabled{ opacity:.4; cursor:default; transform:none; }
  .story-btn:focus-visible{ outline:2px solid var(--maroon-2); outline-offset:3px; }

  .cake-scene{ position:relative; width:230px; margin-bottom:4px; }
  .candles{ display:flex; justify-content:center; gap:18px; position:relative; z-index:2; height:60px; }
  .candle{ position:relative; width:5px; height:28px; background:linear-gradient(180deg,#fff,var(--gold)); border-radius:2px; align-self:flex-end; }
  .flame{ position:absolute; bottom:100%; left:50%; transform:translateX(-50%); width:12px; height:19px; margin-bottom:-2px;
    background:radial-gradient(circle at 50% 75%, #fff7cf 0%, var(--gold) 45%, #d9762f 80%, rgba(217,118,47,0) 100%);
    border-radius:50%/60% 60% 40% 40%; filter:drop-shadow(0 0 5px var(--gold)); animation:flicker 2.3s ease-in-out infinite; transform-origin:bottom center; }
  .candle:nth-child(2) .flame{animation-delay:.25s;} .candle:nth-child(3) .flame{animation-delay:.5s;}
  .candle:nth-child(4) .flame{animation-delay:.1s;} .candle:nth-child(5) .flame{animation-delay:.4s;}
  @keyframes flicker{ 0%,100%{transform:translateX(-50%) rotate(-3deg) scaleY(1);} 50%{transform:translateX(-48%) rotate(3deg) scaleY(.95);} }
  .flame.out{ animation:none; opacity:0; transition:opacity .4s; }
  .tier{ border-radius:6px; margin:0 auto; box-shadow:inset 0 -6px 10px rgba(0,0,0,.08); }
  .tier1{ width:110px; height:34px; background:var(--blush-2); margin-top:-3px; }
  .tier2{ width:150px; height:38px; background:#e7a685; }
  .tier3{ width:190px; height:42px; background:var(--lav); }
  .tier::before{ content:''; display:block; height:8px; background:repeating-linear-gradient(90deg,#fff 0 6px, transparent 6px 12px); opacity:.5; margin-top:4px; }

  .gifts-row{ display:flex; gap:30px; justify-content:center; margin:22px 0 14px; }
  .gift-box{ width:82px; height:86px; position:relative; }
  .gift-base{ position:absolute; bottom:0; left:0; right:0; height:52px; border-radius:4px 4px 10px 10px; background:var(--lav); box-shadow:0 8px 16px rgba(0,0,0,.12); overflow:hidden; }
  .gift-box.b .gift-base{ background:var(--blush-2); }
  .gift-base::before{ content:''; position:absolute; left:50%; top:0; bottom:0; width:9px; background:var(--maroon-2); transform:translateX(-50%); }
  .gift-lid{ position:absolute; left:-6px; right:-6px; top:24px; height:22px; border-radius:6px 6px 3px 3px; background:var(--lav);
    box-shadow:0 6px 12px rgba(0,0,0,.14); transform-origin:bottom center; z-index:2; animation:liftLid 4.2s ease-in-out infinite; }
  .gift-box.b .gift-lid{ background:var(--blush-2); }
  .gift-lid::before{ content:''; position:absolute; left:50%; top:0; bottom:0; width:9px; background:var(--maroon-2); transform:translateX(-50%); }
  .gift-lid::after{ content:''; position:absolute; left:50%; top:-11px; width:24px; height:16px; border-radius:50% 50% 4px 4px; background:var(--maroon-2); transform:translateX(-50%); }
  @keyframes liftLid{
    0%,32%{ transform:translateY(0) rotate(0deg); }
    42%{ transform:translateY(-15px) rotate(-9deg); }
    58%{ transform:translateY(-15px) rotate(-9deg); }
    68%,100%{ transform:translateY(0) rotate(0deg); }
  }
  .burst{ position:absolute; left:50%; top:6px; width:0; height:0; z-index:1; }
  .burst span{ position:absolute; left:0; top:0; font-size:13px; opacity:0; animation:burstPop 4.2s ease-in-out infinite; }
  @keyframes burstPop{
    0%,40%{ opacity:0; transform:translate(0,0) scale(.3); }
    50%{ opacity:1; transform:translate(var(--tx), var(--ty)) scale(1); }
    68%{ opacity:0; transform:translate(calc(var(--tx)*1.5), calc(var(--ty)*1.5)) scale(.6); }
    100%{ opacity:0; }
  }
  .memory-card{ margin-top:26px; background:#fffaf5; border-radius:14px; padding:16px 20px; max-width:250px; box-shadow:0 10px 24px rgba(0,0,0,.08); }
  .memory-photo{ width:100%; aspect-ratio:4/5; border-radius:8px; background:linear-gradient(155deg,var(--blush),var(--lav)); display:flex; align-items:center; justify-content:center; margin-bottom:10px; }
  .memory-photo span{ font-size:11px; color:rgba(90,63,74,.5); }
  .memory-card b{ font-family:'Playfair Display'; font-style:italic; color:var(--maroon); font-size:16px; }
  .memory-card p{ font-size:13px; color:var(--ink-dim); margin:4px 0 0; }

  .board{ position:relative; width:100%; max-width:360px; height:290px; margin-bottom:6px; }
  .polaroid{ position:absolute; width:92px; background:#fff; padding:6px 6px 20px; border-radius:3px; box-shadow:0 8px 16px rgba(0,0,0,.15); }
  .polaroid .ph{ width:100%; aspect-ratio:1/1; background:linear-gradient(160deg,var(--blush),var(--lav)); border-radius:1px; display:flex; align-items:center; justify-content:center; }
  .polaroid .ph span{ font-size:8px; color:rgba(90,63,74,.45); }
  .polaroid p{ font-family:'Playfair Display'; font-style:italic; font-size:10.5px; color:var(--ink); text-align:center; margin:5px 0 0; }
  .p1{ left:2%; top:2%; transform:rotate(-7deg); } .p2{ left:34%; top:12%; transform:rotate(4deg); }
  .p3{ left:66%; top:0%; transform:rotate(-3deg); } .p4{ left:8%; top:46%; transform:rotate(6deg); }
  .p5{ left:40%; top:50%; transform:rotate(-5deg); } .p6{ left:70%; top:44%; transform:rotate(5deg); }

  .notes-sub{ font-size:13px; color:var(--ink-dim); margin-bottom:6px; }
  .counter{ font-size:12px; color:var(--maroon-2); margin-bottom:16px; }
  .notes-grid{ display:grid; grid-template-columns:repeat(3,72px); gap:12px; justify-content:center; }
  .note{ width:72px; height:72px; perspective:600px; cursor:pointer; }
  .note-inner{ position:relative; width:100%; height:100%; transition:transform .5s; transform-style:preserve-3d; }
  .note.flipped .note-inner{ transform:rotateY(180deg); }
  .note-face{ position:absolute; inset:0; border-radius:8px; display:flex; align-items:center; justify-content:center; backface-visibility:hidden; padding:6px; }
  .note-front{ background:var(--blush-2); font-size:22px; }
  .note-back{ background:#fffaf5; transform:rotateY(180deg); font-size:9.5px; line-height:1.35; color:var(--ink); box-shadow:inset 0 0 0 1px rgba(143,46,74,.12); }

  .letter{ background:#fffaf5; border-radius:12px; padding:22px 24px; max-width:340px; box-shadow:0 10px 26px rgba(0,0,0,.1); text-align:left; }
  .letter .to{ font-size:12px; color:var(--ink-dim); text-align:center; margin:0 0 2px; }
  .letter h2{ text-align:center; margin-bottom:14px; }
  .letter p{ font-size:14px; line-height:1.7; color:var(--ink); margin:0 0 12px; }
  .letter .sign{ font-family:'Playfair Display'; font-style:italic; color:var(--maroon); text-align:right; font-size:15px; }

  .balloon{ position:absolute; width:34px; height:42px; border-radius:50% 50% 50% 50%/58% 58% 42% 42%; animation:bob 3.4s ease-in-out infinite; }
  @keyframes bob{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-14px);} }
  .final-card{ margin-top:20px; background:#fffaf5; border-radius:14px; padding:18px 24px; max-width:280px; box-shadow:0 10px 24px rgba(0,0,0,.08); position:relative; z-index:2; }
  .final-card p{ font-family:'Playfair Display'; font-style:italic; color:var(--maroon); font-size:16px; line-height:1.5; margin:0 0 10px; }
  .final-card .small{ font-family:'Quicksand'; font-style:normal; color:var(--ink-dim); font-size:12px; }

  .dots{ position:fixed; bottom:calc(14px + env(safe-area-inset-bottom,0px)); left:0; right:0; display:flex; justify-content:center; gap:8px; z-index:3; }
  .dot{ width:6px; height:6px; border-radius:50%; background:rgba(143,46,74,.25); border:none; padding:0; cursor:pointer; transition:transform .2s,background .2s; }
  .dot.active{ background:var(--maroon); transform:scale(1.4); }

  @media (prefers-reduced-motion: reduce){ .flame,.balloon,.pager,.note-inner{ transition:none !important; animation:none !important; } }
</style>
</head>
<body>

<div class="pager" id="pager">

  <section class="page">
    <p class="eyebrow">today is all about you</p>
    <h1>Ayesha!</h1>
    <p class="sub">Today is wrapped just for you — blow out the candles and open what's next.</p>
    <div class="cake-scene">
      <div class="candles" id="candles">
        <div class="candle"><div class="flame"></div></div>
        <div class="candle"><div class="flame"></div></div>
        <div class="candle"><div class="flame"></div></div>
        <div class="candle"><div class="flame"></div></div>
        <div class="candle"><div class="flame"></div></div>
      </div>
      <div class="tier tier1"></div><div class="tier tier2"></div><div class="tier tier3"></div>
    </div>
    <button class="story-btn" id="blowBtn">Blow the Candles</button>
  </section>

  <section class="page">
    <h2>Just for you</h2>
    <p class="sub">A couple of little things, waiting to be opened.</p>
    <div class="gifts-row">
      <div class="gift-box">
        <div class="burst">
          <span style="--tx:-26px;--ty:-30px;color:var(--gold);animation-delay:0s">✦</span>
          <span style="--tx:2px;--ty:-38px;color:var(--maroon-2);animation-delay:.05s">✧</span>
          <span style="--tx:28px;--ty:-28px;color:var(--lav);animation-delay:.1s">✦</span>
          <span style="--tx:-18px;--ty:-14px;color:var(--blush-2);animation-delay:.15s">•</span>
          <span style="--tx:18px;--ty:-14px;color:var(--gold);animation-delay:.2s">•</span>
        </div>
        <div class="gift-lid"></div>
        <div class="gift-base"></div>
      </div>
      <div class="gift-box b">
        <div class="burst">
          <span style="--tx:-26px;--ty:-30px;color:var(--maroon-2);animation-delay:.9s">✧</span>
          <span style="--tx:2px;--ty:-38px;color:var(--gold);animation-delay:.95s">✦</span>
          <span style="--tx:28px;--ty:-28px;color:var(--maroon-2);animation-delay:1s">✧</span>
          <span style="--tx:-18px;--ty:-14px;color:var(--gold);animation-delay:1.05s">•</span>
          <span style="--tx:18px;--ty:-14px;color:var(--lav);animation-delay:1.1s">•</span>
        </div>
        <div class="gift-lid" style="animation-delay:.9s"></div>
        <div class="gift-base"></div>
      </div>
    </div>
    <div class="memory-card">
      <div class="memory-photo"><span>your photo here</span></div>
      <b>A Little Memory</b>
      <p>Remember this day? I still smile every time I think about it.</p>
    </div>
    <button class="story-btn next-cta">Continue the Story →</button>
  </section>

  <section class="page">
    <h2>Little moments</h2>
    <p class="sub">a few of my favorites, scattered here for you</p>
    <div class="board">
      <div class="polaroid p1"><div class="ph"><span>photo</span></div><p>Golden hour</p></div>
      <div class="polaroid p2"><div class="ph"><span>photo</span></div><p>Just us</p></div>
      <div class="polaroid p3"><div class="ph"><span>photo</span></div><p>That smile</p></div>
      <div class="polaroid p4"><div class="ph"><span>photo</span></div><p>Silly night</p></div>
      <div class="polaroid p5"><div class="ph"><span>photo</span></div><p>Afternoon</p></div>
      <div class="polaroid p6"><div class="ph"><span>photo</span></div><p>Hold onto this</p></div>
    </div>
    <button class="story-btn next-cta">Continue the Story →</button>
  </section>

  <section class="page">
    <h2>Things I Love About You</h2>
    <p class="notes-sub">tap the little notes to discover what I love about you</p>
    <p class="counter"><span id="foundCount">0</span> / 7 little secrets discovered</p>
    <div class="notes-grid" id="notesGrid"></div>
    <button class="story-btn next-cta">Continue the Story →</button>
  </section>

  <section class="page">
    <div class="letter">
      <p class="to">for your eyes only</p>
      <h2>Dear Ayesha</h2>
      <p>As personal as you are — not wrapped in ribbon, but written from the quietest corner of my heart.</p>
      <p>Thank you for the way you soften the world, for your laugh that finds me even on heavy days, and for loving with a kind of courage that makes everything feel safer.</p>
      <p>I hope this year brings you soft mornings, bright surprises, and a hundred ordinary moments that somehow feel magical — because that is what you give to me.</p>
      <p class="sign">Always yours</p>
    </div>
    <button class="story-btn next-cta">One Last Surprise →</button>
  </section>

  <section class="page" id="finalPage">
    <p class="eyebrow">today is all about you</p>
    <h2>Happy Birthday, Ayesha!</h2>
    <div class="cake-scene" style="width:170px; transform:scale(.85);">
      <div class="candles"><div class="candle"><div class="flame"></div></div><div class="candle"><div class="flame"></div></div><div class="candle"><div class="flame"></div></div></div>
      <div class="tier tier1" style="width:90px;"></div><div class="tier tier2" style="width:120px;"></div><div class="tier tier3" style="width:150px;"></div>
    </div>
    <div class="final-card">
      <p>May this year bring you everything your heart is hoping for.</p>
      <p class="small">Happy birthday, Ayesha — with all my love.</p>
    </div>
  </section>

</div>

<div class="dots" id="dots"></div>

<script>
  const finalPage = document.getElementById('finalPage');
  const balloonColors = ['#f3b6c2','#d9c6e8','#e9b768','#f7c9cf'];
  for(let i=0;i<6;i++){
    const b = document.createElement('div');
    b.className = 'balloon';
    b.style.left = (5 + Math.random()*90) + '%';
    b.style.top = (8 + Math.random()*55) + '%';
    b.style.background = balloonColors[i % balloonColors.length];
    b.style.animationDelay = (Math.random()*3) + 's';
    finalPage.appendChild(b);
  }
  document.querySelectorAll('.page').forEach((p)=>{
    const f = document.createElement('span');
    f.className='deco'; f.textContent='✿';
    f.style.left='4%'; f.style.bottom='10px'; f.style.color='#e08fa0';
    p.appendChild(f);
    const f2 = document.createElement('span');
    f2.className='deco'; f2.textContent='♡';
    f2.style.right='5%'; f2.style.top='14px'; f2.style.color='#c9a6dc'; f2.style.fontSize='16px';
    p.appendChild(f2);
  });

  const blowBtn = document.getElementById('blowBtn');
  let blown = false;
  blowBtn.addEventListener('click', () => {
    if(blown){ goTo(current+1); return; }
    blown = true;
    document.querySelectorAll('#candles .flame').forEach(f => f.classList.add('out'));
    blowBtn.textContent = 'Continue the Story →';
  });

  const noteTexts = [
    'Being yours — and getting to love you — is my favorite story.',
    'The way you laugh at your own jokes before you finish them.',
    'How steady everything feels when you\'re around.',
    'How you remember the small things about me.',
    'Your kindness, even on your hardest days.',
    'How you make ordinary Tuesdays feel like an event.',
    'You — exactly as you are, no version I\'d trade.'
  ];
  const notesGrid = document.getElementById('notesGrid');
  const foundCount = document.getElementById('foundCount');
  let found = 0;
  noteTexts.forEach((txt) => {
    const n = document.createElement('div');
    n.className = 'note';
    n.innerHTML = '<div class="note-inner"><div class="note-face note-front">♡</div><div class="note-face note-back">'+txt+'</div></div>';
    n.addEventListener('click', () => {
      if(!n.classList.contains('flipped')){
        n.classList.add('flipped');
        found++; foundCount.textContent = found;
      }
    });
    notesGrid.appendChild(n);
  });

  const pager = document.getElementById('pager');
  const pages = document.querySelectorAll('.page');
  const dotsWrap = document.getElementById('dots');
  let current = 0;
  pages.forEach((_, i) => {
    const d = document.createElement('button');
    d.className = 'dot' + (i===0?' active':'');
    d.setAttribute('aria-label','Go to page '+(i+1));
    d.addEventListener('click', () => goTo(i));
    dotsWrap.appendChild(d);
  });
  const dots = document.querySelectorAll('.dot');
  function goTo(i){
    current = Math.max(0, Math.min(pages.length-1, i));
    pager.style.transform = 'translateX(-'+(current*100)+'%)';
    dots.forEach((d,idx)=>d.classList.toggle('active', idx===current));
  }
  document.querySelectorAll('.next-cta').forEach(btn=>{
    btn.addEventListener('click', ()=> goTo(current+1));
  });
  window.addEventListener('keydown', e=>{
    if(e.key==='ArrowRight') goTo(current+1);
    if(e.key==='ArrowLeft') goTo(current-1);
  });
  let touchX=null;
  pager.addEventListener('touchstart', e=>touchX=e.touches[0].clientX, {passive:true});
  pager.addEventListener('touchend', e=>{
    if(touchX===null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if(Math.abs(dx)>50) goTo(current + (dx<0?1:-1));
    touchX=null;
  }, {passive:true});
  goTo(0);
</script>

</body>
</html>
